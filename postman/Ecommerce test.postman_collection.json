    {
      "name": "Product",
      "item": [
        {
          "name": "Product list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "//Structure",
                  "// Data correctness",
                  "//Boundary",
                  "//Duplicate",
                  "// Pagination",
                  "// Business logic (filter/sort)",
                  "// Performance",
                  "// Security",
                  "// Edge cases///",
                  "",
                  "let json = pm.response.json();",
                  "let products = json.products;",
                  "",
                  "//========",
                  "//Chech Data structure",
                  "//========",
                  "pm.test(\"Products is array\", function () {",
                  "    pm.expect(products).to.be.an('array');",
                  "});",
                  "",
                  "//=======",
                  "//Data not empty",
                  "pm.test(\"Products not empty\", function () {",
                  "    pm.expect(products.length).to.be.above(0);",
                  "});",
                  "",
                  "//=====",
                  "",
                  "//3. Structure + data type",
                  "pm.test(\"Each product structure correct\", function () {",
                  "    products.forEach(p => {",
                  "        pm.expect(p).to.have.property('id');",
                  "        pm.expect(p.id).to.be.a(\"number\");",
                  "        pm.expect(p.id).to.be.above(0);",
                  "",
                  "        pm.expect(p).to.have.property('title');",
                  "        pm.expect(p.title).to.be.a(\"string\");",
                  "        pm.expect(p.title).to.not.be.empty;",
                  "",
                  "        pm.expect(p).to.have.property('description');",
                  "        pm.expect(p.description).to.be.a('string');",
                  "        pm.expect(p.description).to.not.be.empty;",
                  "",
                  "        pm.expect(p).to.have.property('price');",
                  "        pm.expect(p.price).to.be.not.null;",
                  "        pm.expect(p.price).to.be.a('number');",
                  "",
                  "",
                  "    });",
                  "});",
                  "//====",
                  "//Duplicate Check",
                  "pm.test(\"No duplicate product id\", function () {",
                  "    const ids = products.map(p => p.id);",
                  "    pm.expect(ids.length).to.equal(new Set(ids).size);",
                  "});",
                  "",
                  "//====",
                  "//Pagination",
                  "pm.test(\"Limit correct\", function () {",
                  "    pm.expect(products.length).to.be.at.most(30);",
                  "});",
                  "",
                  "",
                  "//===",
                  "//Performance",
                  "pm.test(\"Respone time < 500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "//===",
                  "//Security",
                  "pm.test(\"No sensitive data exposed\", function () {",
                  "    products.forEach(p => {",
                  "        pm.expect(p).to.not.have.property(\"password\");",
                  "        pm.expect(p).to.not.have.property(\"sensitive\");",
                  "        pm.expect(p).to.not.have.property(\"internalCost\");",
                  "    });",
                  "});",
                  "",
                  "//====",
                  "// Edge cases",
                  "//====",
                  "pm.test(\"Handle emplty or null fields\", function () {",
                  "    products.forEach(p => {",
                  "        pm.expect(p.price).to.not.be.null;",
                  "        pm.expect(p.title).to.not.be.null;",
                  "    });",
                  "});",
                  "",
                  "// Business logic - category field valid",
                  "pm.test(\"Filter category = beauty\", function () {",
                  "    products.forEach(p => {",
                  "        pm.expect(p).to.have.property('category');",
                  "        pm.expect(p.category).to.be.a('string');",
                  "        pm.expect(p.category).to.not.be.empty;",
                  "    });",
                  "});",
                  "",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
