        {
          "name": "Get Product List - Limit 5",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "//1. status code",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "//2. Response time",
                  "pm.test(\"Response time must be less than 500ms\", function (){",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "//3. Products structure Array",
                  "pm.test(\"Products structure Array \", function () {",
                  "    let data = pm.response.json();",
                  "    let products = data.products;",
                  "    products.forEach(p => {",
                  "        pm.expect(p).to.have.property('id');",
                  "    }",
                  "    );",
                  "});",
                  "pm.test(\"Products structure Array\", function () {",
                  "    let data = pm.response.json();",
                  "    let products = data.products;",
                  "",
                  "    products.forEach(p => {",
                  "        pm.expect(p).to.have.property('id');",
                  "        pm.expect(p.id).to.be.a('number');",
                  "",
                  "        pm.expect(p).to.have.property('title');",
                  "        pm.expect(p.title).to.be.a('string');",
                  "",
                  "        pm.expect(p).to.have.property('category');",
                  "        pm.expect(p.category).to.be.a('string');",
                  "",
                  "    });",
                  "});",
                  "",
                  "//4. Test Dimensions",
                  "pm.test(\"Dimensions structure safe\", function (){",
                  "    let data = pm.response.json();",
                  "    let products = data.products;",
                  "    products.forEach(p => {",
                  "        let d = p.dimensions;",
                  "        pm.expect(d.width).to.be.a('number');",
                  "        pm.expect(d.height).to.be.a('number');",
                  "        pm.expect(d.depth).to.be.a('number');",
                  "",
                  "        pm.expect(d.width).is.not.null;",
                  "    });",
                  "});",
                  "",
                  "//5 Test tags",
                  "pm.test(\"Tags are corrected\", function () {",
                  "    let data = pm.response.json();",
                  "    let products = data.products;",
                  "    products.forEach(p => {",
                  "        pm.expect(p).to.have.property('tags');",
                  "        pm.expect(p.tags).to.be.an('array');",
                  "        p.tags.forEach(t => {",
                  "            pm.expect(t).to.be.a('string');",
                  "        });",
                  "    });",
                  "});",
                  "",
                  "",
                  "//=======",
                  "//Test reviews",
                  "pm.test(\"Reviews infor corrected\", function () {",
                  "    let data = pm.response.json();",
                  "    let products = data.products;",
                  "    products.forEach(p => {",
                  "        pm.expect(p).to.have.property('reviews');",
                  "        pm.expect(p.reviews).to.be.an('array');",
                  "        p.reviews.forEach(r => {",
                  "            pm.expect(r).to.have.property('rating');",
                  "            pm.expect(r.rating).to.be.a('number');",
                  "            pm.expect(r).to.have.property('comment');",
                  "            pm.expect(r.comment).to.be.a('string');",
                  "            pm.expect(r).to.have.property('reviewerName');",
                  "            pm.expect(r.reviewerName).to.be.a('string');",
                  "        });",
                  "    });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
