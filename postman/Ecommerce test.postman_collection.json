        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login success\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let jsonData = pm.response.json();",
                  "",
                  "//Save token",
                  "pm.environment.set(\"token\", jsonData.accessToken);",
                  "",
                  "//Validate token tồn tại",
                  "pm.test(\"Token exist\", function () {",
                  "    pm.expect(jsonData.accessToken).to.exist;",
                  "});",
                  "",
                  "//Test username",
                  "pm.test (\"Username correct\", function () {",
                  "    pm.expect(jsonData.username).to.eql(\"emilys\");",
                  "});",
                  "",
                  "//Test data correct structure",
                  "pm.test(\"Response data correct structure\", function () {",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "    pm.expect(jsonData.username).to.be.a('string');",
                  "    pm.expect(jsonData.email).to.be.a('string');",
                  "    pm.expect(jsonData.firstName).to.be.a('string');",
                  "    pm.expect(jsonData.lastName).to.be.a('string');",
                  "    pm.expect(jsonData.gender).to.be.a('string');",
                  "    pm.expect(jsonData.image).to.be.a('string');",
                  "});",
                  "",
                  "//Test field exist",
                  "pm.test(\"Response data exist fields\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property(\"email\");",
                  "});",
                  "",
                  "//Check type",
                  "pm.test(\"Respone correct types\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.username).to.be.a(\"string\");",
                  "    pm.expect(jsonData.id).is.not.null;",
                  "});",
                  "",
                  "//Validate user schema",
                  "pm.test(\"Valida user schema\", function () {",
                  "    let jsonData = pm.response.json();",
                  "",
                  "    let expectedFields = [",
                  "        \"id\",",
                  "        \"username\",",
                  "        \"emai\",",
                  "        \"firstName\",",
                  "        \"lastName\",",
                  "        \"gender\",",
                  "        \"image\"",
                  "",
                  "    ]",
                  "});",
                  "",
                  "//Level cao hơn",
                  "let schema = {",
                  "    type: \"object\",",
                  "    required: [\"id\", \"username\", \"email\"],",
                  "    properties: {",
                  "        id: {type: \"number\"},",
                  "        username: {type: \"string\"},",
                  "        email: {type: \"string\"}",
                  "    }",
                  "};",
                  "pm.test(\"Schema valid\", function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
